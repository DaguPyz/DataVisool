# init will fill the application image and the owner of the host data directories.
DATAVISOOL_IMAGE=datavisool-web:2026.9.0
DATAVISOOL_PROJECT_NAME=datavisool-web-app
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
# 留空时，Linux/macOS 启动器首次启动会使用当前用户；Windows 使用容器默认值。
APP_UID=
APP_GID=

# Connect to an EXISTING host MySQL database, not a database container.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=
DB_USER=
# Launchers save entered values in double quotes, escaping backslash, quote and dollar for Compose.
# Manually entered single-quoted dotenv values are also supported. Never source this file in a shell.
DB_PASSWORD=

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Duser.timezone=Asia/Shanghai

