  "scripts": {
    "docs:generate": "node scripts/component-docs.mjs",
    "docs:test": "node --test scripts/component-docs.test.mjs",
    "dev": "vite --config vite.dev.config.ts",
    "build:local": "pnpm docs:generate && tsc && vite build --config vite.build.config.ts",
