    "action:local": "vite build --config vite.build.config.ts",
    "action": "pnpm run action:local",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check": "pnpm docs:generate && tsc --noEmit --watch",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "verify:shared": "pnpm run test && pnpm run build",
    "preview": "pnpm build && vite preview"
  },
