DATAVISOOL_PROJECT_NAME=datavisool-web-allinone
DATAVISOOL_IMAGE=datavisool-web-allinone:0.0.0

# Required on first deployment; use the same values when reusing existing data/.
DB_NAME=
DB_USER=
DB_PASSWORD=

APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50.0 -Duser.timezone=Asia/Shanghai
TZ=Asia/Shanghai
